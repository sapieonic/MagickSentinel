# Generated by deploy/gen-dev-secrets.sh, or written by hand from .env.example.
#
# Never committed. Every value in it is a credential with no default — compose
# references them as ${VAR:?} precisely so that a missing one is a named error rather
# than a silent empty string, and committing a working one would undo that.
.env
.env.*
!.env.example

# Local override, for a machine-specific port or image tag. Compose picks
# compose.override.yaml up automatically, which is exactly why it must not be shared:
# a committed override changes the stack for everyone without appearing in the file
# they are reading.
compose.override.yaml
compose.override.yml
