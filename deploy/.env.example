# Copy to deploy/.env, then either fill it in or run deploy/gen-dev-secrets.sh, which
# writes one with random values.
#
# EVERY CREDENTIAL BELOW IS A PLACEHOLDER AND DELIBERATELY NOT A WORKING DEFAULT.
# deploy/compose.yaml references them as ${VAR:?message}, so compose fails with a named
# error rather than substituting an empty string. That is the whole reason this file is
# an `.example` rather than a committed `.env`: a dev default that works everywhere is
# a dev default that reaches production, and the first person to notice is whoever
# finds postgres/postgres on a host that is not a laptop.
#
# deploy/.gitignore ignores `.env`. Do not commit one.

# ---------------------------------------------------------------------- Postgres
# The schema owner. Migrations run as this role because they create roles and
# row-level-security policies, which sentinel_app cannot and must not be able to do.
POSTGRES_USER=sentinel_owner
POSTGRES_PASSWORD=CHANGE_ME_owner
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# The two application roles. db/migrations/0003_roles.up.sql creates both with LOGIN
# and NO password — correct for a file in git, and insufficient for anything that
# connects over TCP, since scram-sha-256 has nothing to verify against. The migration
# runner sets them from these two values; ci.yml documents the same wrinkle and works
# around it the same way.
#
# Both roles are NOBYPASSRLS. Tenant isolation in this product lives in the database,
# not the application: the gateway runs every query inside a transaction carrying
# `sentinel.tenant_id`, and when that context is absent the policies return zero rows
# rather than all of them. A role with BYPASSRLS silently defeats all of it, which is
# why both the migration runner and the pipeline entrypoint refuse to proceed if they
# find one.
SENTINEL_APP_PASSWORD=CHANGE_ME_app
SENTINEL_PIPELINE_PASSWORD=CHANGE_ME_pipeline

# ------------------------------------------------------------------------- NATS
# Three separate credentials, because they need three different permission sets. The
# gateway publishes finalize messages and cannot consume them; the pipeline consumes
# them and cannot mint them; the system account is reachable by neither. A single
# shared token would give whichever component is easier to compromise — the gateway,
# which is on the public internet — the ability to drain the queue.
#
# Draining the queue is the expensive one: a finalize message represents a call whose
# audio the endpoint agent has already deleted, because the gateway acked it. Those
# calls are unrecoverable and surface only as a coverage gap, months later.
NATS_GATEWAY_USER=sentinel-gateway
NATS_GATEWAY_PASSWORD=CHANGE_ME_nats_gateway
NATS_PIPELINE_USER=sentinel-pipeline
NATS_PIPELINE_PASSWORD=CHANGE_ME_nats_pipeline
NATS_SYS_USER=sentinel-sys
NATS_SYS_PASSWORD=CHANGE_ME_nats_sys
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ------------------------------------------------------------------------ MinIO
# Root creates the bucket and the least-privileged application user, and then is not
# used by anything else. The application credential can read, write and delete objects
# and cannot delete the bucket or change its policy — deleting every recorded call in
# a deployment is the single most damaging thing available to a compromised worker in a
# product whose claim is that 100% of calls are monitored and retained.
MINIO_ROOT_USER=sentinel-root
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

SENTINEL_S3_BUCKET=sentinel-audio
SENTINEL_S3_ACCESS_KEY=sentinel-app
SENTINEL_S3_SECRET_KEY=CHANGE_ME_s3_secret

# OPEN-4: data residency. The working assumption recorded in docs/open-decisions.md is
# India only, asserted in contracts/openapi.yaml as ap-south-1 and enforced by nothing.
# It is set here so nobody develops against a us-east-1 default and meets the question
# at deployment time — but it is an assumption, and the thing that would settle it is
# written confirmation from the bank client, not this line.
#
# The region a bucket was created in is the one fact about an object store that cannot
# be changed afterwards.
SENTINEL_S3_REGION=ap-south-1

# ---------------------------------------------------------------------- gateway
GATEWAY_PORT=8080
# Sets the expected issuer and audience for Identity Platform ID tokens. Any string
# works until there is a real project; it is not a credential.
SENTINEL_GCP_PROJECT=sentinel-local
SENTINEL_VERSION=dev

# --------------------------------------------------------------------- pipeline
# selftest validates configuration and connectivity and holds. It does not process
# calls, because nothing in this repository implements worker.py's SegmentSource/Sink
# Protocols yet. `consume` is the seam and additionally needs SENTINEL_PIPELINE_SINK.
SENTINEL_PIPELINE_MODE=selftest

# Provider SDKs are optional extras baked into the image at build time, so this has to
# match SENTINEL_ASR_PROVIDER: google | sarvam | anthropic | openai | whisper.
PIPELINE_EXTRAS=google

# Leave SENTINEL_ASR_PROVIDER empty to take providers/registry.py's default. Note what
# the default means for OPEN-4: it reaches the Gemini API through a global endpoint, so
# it is borrower audio leaving India. It is *processing* rather than storage, and it is
# now the default rather than something someone opted into.
#
# The two exits, both configuration rather than code, which is why the registry exists:
#   SENTINEL_ASR_PROVIDER=sarvam   India-hosted, at the cost of per-word evidence spans
#   SENTINEL_ASR_PROVIDER=whisper  self-hosted, at the cost of running it ourselves
SENTINEL_ASR_PROVIDER=

# The floor's languages. This is not decoration: registry.validate refuses to start on
# a language the chosen provider cannot read, because the default provider has no Tamil
# at all and a Tamil floor pointed at it would not fail — it would transcribe Tamil
# audio as something else and hand a bank a clean-looking transcript with no compliance
# flags on it.
SENTINEL_ASR_LANGUAGES=hi-IN,en-IN
# Per-language overrides, e.g. ta-IN=sarvam
SENTINEL_ASR_ROUTES=

SENTINEL_GOOGLE_API_KEY=
SENTINEL_SARVAM_API_KEY=
SENTINEL_LOG_LEVEL=INFO

# ----------------------------------------------------------------- observability
# Only read when deploy/observability/compose.yaml is layered in. Grafana's admin
# password; the anonymous-viewer question is answered in that file's comments.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
GRAFANA_PORT=3000
