# Portal build configuration.
#
# Copy to `.env.local` for development, or supply these as build-time environment
# variables in CI. Vite inlines every VITE_-prefixed variable into the bundle, so
# nothing secret may go in this file — and nothing here is: the Identity Platform web
# configuration identifies the project and ships in every Firebase web app. The secret
# is the ID token, which is minted in the browser and only ever leaves it as a bearer
# header to the gateway.
#
# Two variables have no default and a production build refuses to start without them:
# VITE_IDENTITY_TENANT_ID (guessing it would sign users in outside the customer's
# isolation boundary) and VITE_API_BASE_URL (defaulting it to localhost is the mistake
# that presents as a blank screen in staging).

# ---------------------------------------------------------------- gateway

# Origin only, no path, no trailing path segment. Must match one of the origins the
# gateway will accept: SENTINEL_ALLOWED_ORIGINS has to list the address this portal is
# *served from*, and this variable is the address it *talks to*. Getting one wrong
# looks exactly like the gateway being down.
# The development fallback, used only in a dev build, is http://localhost:8080.
VITE_API_BASE_URL=https://api.sentinel.magickvoice.com

# ------------------------------------------------- Google Identity Platform

# From the Firebase/Identity Platform web app configuration.
VITE_IDENTITY_API_KEY=
VITE_IDENTITY_AUTH_DOMAIN=sentinel-prod.firebaseapp.com

# The GCP project. The gateway's expected token issuer is
# https://securetoken.google.com/<VITE_IDENTITY_PROJECT_ID>, so this must name the same
# project as the gateway's configuration or every token is refused.
VITE_IDENTITY_PROJECT_ID=sentinel-prod

# REQUIRED. One Identity Platform tenant per BPO customer; this is the hard isolation
# boundary at the auth layer, and the gateway checks the resulting firebase.tenant
# claim on every request. There is no default and there must never be one.
VITE_IDENTITY_TENANT_ID=

# Optional. Shown on the sign-in screen next to the tenant id, so an operator can see
# which customer's portal they are about to sign in to.
VITE_IDENTITY_TENANT_LABEL=

# ------------------------------------------------------- sign-in methods
#
# OPEN-2 in docs/open-decisions.md — whether the customer runs Entra ID — is still
# open, and these variables are how it stays open. Enable either route, or both during
# a migration. Answering OPEN-2 should change this file and nothing else.

# Optional. An Identity Platform federated provider id: `saml.<name>` for a SAML
# federation (Entra ID, ADFS) or `oidc.<name>` for an OIDC one. Leave empty for no SSO.
VITE_IDENTITY_FEDERATED_PROVIDER_ID=

# Optional. The SSO button's label. Defaults to "Sign in with your work account".
VITE_IDENTITY_FEDERATED_LABEL=

# Optional, defaults to true. Set false on a floor where SSO is the only permitted
# route, so no email/password form is rendered at all.
VITE_IDENTITY_PASSWORD_SIGN_IN=true

# Optional, `popup` (default) or `redirect`. Popup keeps the portal's state across the
# round trip but is defeated by a pop-up blocker; redirect always works but reloads the
# page and reports an IdP rejection on the way back in. Both are handled.
VITE_IDENTITY_FEDERATED_FLOW=popup

# Optional, `session` (default) or `local`. `session` ends the signed-in session when
# the tab closes, which is the right default for a shared supervisor workstation on a
# collections floor. `local` keeps it across restarts — more convenient, and a
# deliberate choice rather than an accident.
VITE_IDENTITY_PERSISTENCE=session
